# ==============================================================================
# Inkloom AI — Evidence-Driven Brand Governance with BrandTrace Intelligence
# Environment Configuration Template
# ==============================================================================

# Application Environment
INKLOOM_ENV=development
DEMO_MODE=true
SECRET_KEY=inkloom-brandtrace-secret-key-development-only-2026

# Database Configuration
# Local SQLite for immediate out-of-the-box execution:
DATABASE_URL=sqlite+aiosqlite:///./inkloom.db
DATABASE_SYNC_URL=sqlite:///./inkloom.db

# Production PostgreSQL configuration (optional):
# DATABASE_URL=postgresql+asyncpg://inkloom_user:secure_password@localhost:5432/inkloom_db
# DATABASE_SYNC_URL=postgresql://inkloom_user:secure_password@localhost:5432/inkloom_db

# AI Engine Provider Configuration
# Options: 'deterministic_fallback' (default, 100% offline), 'gemini', 'openai'
AI_PROVIDER=deterministic_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Network Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
