# ==============================================================================
# Inkloom AI — Frontend Environment Template
# ==============================================================================
# Integrated Local Development (Single Origin: http://localhost:5173):
# Directs browser API calls through the Vite reverse proxy at /api -> http://localhost:8000
VITE_API_BASE_URL=/api

# Production Deployment (e.g. Render, Vercel, Cloud Run):
# Set to your production backend URL or leave /api if using a production reverse proxy (e.g., Nginx)
# VITE_API_BASE_URL=https://inkloom-backend.onrender.com
